        "# IQR-based outlier count per stock\n",
        "def count_outliers(x):\n",
        "    q1, q3 = x.quantile(0.25), x.quantile(0.75)\n",
        "    iqr = q3 - q1\n",
        "    return ((x < q1 - 1.5*iqr) | (x > q3 + 1.5*iqr)).sum()\n",
        "\n",
        "outlier_counts = df.groupby('stock')['final_sentiment'].apply(count_outliers).sort_values(ascending=False)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(12, 4))\n",
        "ax.bar(outlier_counts.index, outlier_counts.values, color='tomato', edgecolor='white')\n",
        "ax.set_title('Outlier Count per Stock (IQR method on final_sentiment)', fontsize=12, fontweight='bold')\n",
        "ax.set_ylabel('Number of Outliers')\n",
